DATABASE_URL="file:./dev.db"
PORT=4000
JWT_SECRET="replace-with-a-strong-random-secret"

# Optional integrations
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="mailer@example.com"
SMTP_PASS="replace-with-app-password"
WHATSAPP_BOOKING_SECRET="replace-with-long-random-secret"
WHATSAPP_SERVICE_URL="http://localhost:5000"

# Supabase sync configuration (SQLite is source of truth)
SYNC_ENABLED=true
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SYNC_CLINIC_ID="clinic-uuid-from-supabase-clinics-table"
SYNC_DEVICE_ID="device-unique-id"
SYNC_INTERVAL_MS=5000
SYNC_BATCH_SIZE=50
