{
  "name": "orisyn",
  "private": true,
  "version": "1.0.0",
  "description": "The AI Operating System for Dental Clinics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:renderer && npm run build:python && electron-builder",
    "build:renderer": "tsc && vite build",
    "build:python": "node ./scripts/build-python-service.mjs",
    "dist:mac": "npm run build:renderer && npm run build:python && electron-builder --mac",
    "dist:win": "npm run build:renderer && npm run build:python && electron-builder --win",
    "dist:publish": "npm run build:renderer && npm run build:python && electron-builder --publish always",
    "dist:mac:publish": "npm run build:renderer && npm run build:python && electron-builder --mac --publish always",
    "dist:win:publish": "npm run build:renderer && npm run build:python && electron-builder --win --publish always",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-toast": "^1.2.15",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.12.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.23",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.4.0",
    "@testing-library/react": "^14.2.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/user-event": "^14.5.2",
    "jsdom": "^24.0.0"
  },
  "main": "dist-electron/main.js"
}