%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "primaryColor": "#ffffff", "secondaryColor": "#f9f9f9", "tertiaryColor": "#ffffff"}}}%%
flowchart TD
    %% Global Styles
    classDef main fill:#ffffff,stroke:#000000,stroke-width:3px,color:#000000,font-weight:bold;
    classDef box fill:#ffffff,stroke:#333333,stroke-width:2px,color:#000000;
    classDef db fill:#e1f5fe,stroke:#01579b,stroke-width:2px,color:#01579b,font-weight:bold;
    classDef cloud fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#e65100,font-weight:bold;

    %% TOP LAYER: USER & FRONTEND
    subgraph ClientLayer ["<b>1. CLIENT LAYER (ON TOP)</b>"]
        direction TB
        User([<b>USER / DENTIST</b>])
        Frontend{{"<b>FRONTEND APP</b><br/>Vite + React + Electron<br/>(Desktop Application)"}}
        User <==> Frontend
    end

    %% MIDDLE LAYER: SERVICES
    subgraph Services ["<b>2. SYSTEM SERVICES (BUSINESS LOGIC)</b>"]
        direction TB
        
        subgraph Row1 [" "]
            direction LR
            MainBackend["<b>MAIN BACKEND</b><br/>Node/Express + Prisma<br/>Port 4000"]
            AIBackend["<b>AI BACKEND</b><br/>Node/Express + Mongoose<br/>Port 3000"]
        end

        subgraph Row2 [" "]
            direction LR
            UPIPay["<b>UPI PAYMENT SERVER</b><br/>Node/Express<br/>Port 3002"]
            AIService["<b>AI CORE SERVICE</b><br/>Python + FastAPI<br/>Port 8000"]
        end
    end

    %% BOTTOM LAYER: DATABASES
    subgraph DataStorage ["<b>3. DATA STORAGE (PERSISTENCE)</b>"]
        direction LR
        MainDB[("<b>CORE DB</b><br/>SQLite (dev.db)")]
        AIDB[("<b>AI DATA</b><br/>MongoDB Atlas")]
        PayDB[("<b>PAYMENT DB</b><br/>SQLite")]
    end

    %% EXTERNAL SYMBOLS
    Deepgram([<b>DEEPGRAM API</b>])
    Gmail([<b>GMAIL IMAP</b>])

    %% CONNECTIONS (BOLD ARROWS FOR LAYERING)
    ClientLayer ===> Services
    
    MainBackend ===> MainDB
    AIBackend ===> AIDB
    UPIPay ===> PayDB

    AIService <--> Deepgram
    UPIPay <--> Gmail
    AIBackend <--> AIService

    %% Applying Classes
    class Frontend main;
    class MainBackend,AIBackend,UPIPay,AIService box;
    class MainDB,AIDB,PayDB db;
    class Deepgram,Gmail cloud;
    style Services fill:#ffffff,stroke:#333333,stroke-width:2px;
    style Row1 fill:#ffffff,stroke:none;
    style Row2 fill:#ffffff,stroke:none;
    style ClientLayer fill:#ffffff,stroke:#333333,stroke-width:2px;
    style DataStorage fill:#ffffff,stroke:#333333,stroke-width:2px;
