%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "primaryColor": "#ffffff", "secondaryColor": "#ffffff", "tertiaryColor": "#ffffff"}}}%%
flowchart LR
    %% -- CUSTOM STYLING --
    classDef MainDB fill:#E3F2FD,stroke:#1976D2,stroke-width:2px,color:#0D47A1
    classDef AIDB fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20
    classDef PayDB fill:#FFF8E1,stroke:#FFA000,stroke-width:2px,color:#FF6F00

    %% -- LEFT SIDE: PRIMARY RELATIONAL CORE (dev.db) --
    subgraph LeftSide ["Primary Database (dev.db)"]
        direction TB
        subgraph MainSystem ["🖥️ Clinical Core (SQLite)"]
            direction TB
            User_T("<b>User Table</b><hr/>id (PK)<br/>name<br/>phone<br/>role (Enum)<br/>createdAt"):::MainDB
            Patient_T("<b>Patient Table</b><hr/>id (PK)<br/>patientId (UK)<br/>name<br/>phone<br/>age / gender<br/>address<br/>createdAt"):::MainDB
            Visit_T("<b>Visit Table</b><hr/>id (PK)<br/>visitId (UK)<br/>patientId (FK)<br/>doctorId (FK)<br/>symptoms<br/>diagnosis<br/>clinicalStatus<br/>paymentStatus"):::MainDB
            Billing_T("<b>Billing Table</b><hr/>id (PK)<br/>billId (UK)<br/>visitId (FK)<br/>currentCharges<br/>totalAmount<br/>paidAmount<br/>pendingAmount"):::MainDB

            User_T --> Visit_T
            Patient_T --> Visit_T
            Visit_T --- Billing_T
        end
    end

    %% -- RIGHT SIDE: SERVICE-SPECIFIC DATABASES (Atlas & Payments) --
    subgraph RightSide ["Extended Services (AI & Payments)"]
        direction TB
        
        subgraph AISystem ["🧠 MongoDB Atlas (AI/Doc)"]
            direction TB
            EMR_C("<b>EMR Collection</b><hr/>_id (PK)<br/>patientId<br/>visitId<br/>chiefComplaint<br/>symptoms (Array)<br/>vitals (BP, HR, BMI)<br/>aiInsights (Risk Scores)<br/>audit (Version)"):::AIDB
            Med_C("<b>Medicines Collection</b><hr/>_id (PK)<br/>icdCode<br/>disease<br/>medications (Array)<br/>tests (Array)<br/>embedding (Vector)"):::AIDB
        end

        subgraph PaymentSystem ["💳 Payments (SQLite)"]
            direction TB
            Orders_T("<b>Orders Table</b><hr/>id (PK)<br/>fullName<br/>normalizedName<br/>baseAmount<br/>finalAmount<br/>status (PAID/PENDING)<br/>utr<br/>createdAt"):::PayDB
        end
    end

    %% -- USE CASE LINKS --
    Visit_T == "<b>Clinical Data Synthesis</b>" ==> EMR_C
    Billing_T == "<b>Financial Reconciliation</b>" ==> Orders_T
