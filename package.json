{
  "name": "dentalcare-workspace",
  "private": true,
  "scripts": {
    "setup": "npm --prefix dentalcare install --no-audit --no-fund && npm --prefix dentalcare/backend install --no-audit --no-fund && npm --prefix ai-backend install --no-audit --no-fund && npm --prefix upi-pay install --no-audit --no-fund && ./dental/bin/pip install -r ai-service/requirements.txt",
    "clean": "./dental/bin/python kill_ports.py",
    "start": "npm run clean && npx concurrently --kill-others-on-fail --names FRONTEND,BACKEND,AI-SERVICE,AI-BACKEND,WHATSAPP,NGROK,UPI-PAY --prefix-colors blue,green,yellow,magenta,cyan,red,white \"npm --prefix dentalcare run dev\" \"npm --prefix dentalcare/backend run start\" \"npm run start:ai-py\" \"npm --prefix ai-backend run start\" \"npm run start:whatsapp\" \"npm run start:ngrok\" \"npm --prefix upi-pay run start\"",
    "start:full": "npm run start",
    "start:frontend": "npm --prefix dentalcare run dev",
    "start:backend": "npm --prefix dentalcare/backend run start",
    "start:ai-node": "npm --prefix ai-backend run start",
    "start:ai-py": "cd ai-service && ../dental/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "start:whatsapp": "./dental/bin/python whatsapp/whatsapp.py",
    "start:ngrok": "node scripts/start-ngrok.js",
    "start:upi": "npm --prefix upi-pay run start"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react-day-picker": "^9.13.0",
    "react-hook-form": "^7.71.1",
    "react-resizable-panels": "^4.4.1",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "supertest": "^7.2.2"
  }
}
